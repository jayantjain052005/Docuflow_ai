# DocuFlow AI - Environment Variables
# Copy this file to .env and fill in your private values.

# Required
SECRET_KEY=change_this_to_a_long_random_string
GEMINI_API_KEY=your_gemini_api_key_here

# Optional AI provider
GROQ_API_KEY=your_groq_api_key_here

# Flask / uploads
FLASK_ENV=development
FLASK_DEBUG=1
MAX_UPLOAD_MB=16
UPLOAD_FOLDER=uploads

# Twilio WhatsApp Sandbox / Twilio WhatsApp Business
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
YOUR_WHATSAPP_NUMBER=whatsapp:+91xxxxxxxxxx

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=choose_a_private_verify_token
WHATSAPP_TOKEN=your_meta_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# Backward-compatible aliases used by older local scripts
TOKEN=your_meta_cloud_api_access_token
PHONE_NUMBER_ID=your_meta_phone_number_id
